CANONICAL_ORIGIN=https://YOUR-LXC-MAGICDNS-NAME.YOUR-TAILNET.ts.net
SHOPPING_LIST_IMAGE=ghcr.io/dustin-ward/shopping-list:vX.Y.Z
PUBLISHED_PORT=3000
LOG_LEVEL=info

# Receipt scanning (optional). Start the sidecar with
#   docker compose -f compose.prod.yaml --profile ocr up -d
# and set RECEIPT_OCR_URL. RECEIPT_OCR_IMAGE carries the same release tag as
# SHOPPING_LIST_IMAGE; when it is unset the compose file falls back to the
# published `latest` sidecar image. RECEIPT_OCR_TOKEN is optional; when set,
# give both containers the same value and keep it out of version control.
# RECEIPT_OCR_URL=http://receipt-ocr:8060/ocr
RECEIPT_OCR_IMAGE=ghcr.io/dustin-ward/shopping-list-receipt-ocr:vX.Y.Z
# RECEIPT_OCR_TOKEN=

# Capture settings default to USD, images under the /data volume, and the
# capture-first retention of `keep`; backup runs archive whatever is still on
# disk (see docs/operations.md).
# RECEIPT_CURRENCY=USD
# RECEIPT_IMAGE_RETENTION=keep

# Optional fallback re-parse helper (R4). Leave RECEIPT_HELPER_URL unset to keep
# the tier off; review works exactly as before. No engine ships with the app —
# the URL points at a server-side engine you evaluate and run yourself. See
# docs/adr/0004-fallback-reparse-tier.md and docs/degraded-receipts.md.
# RECEIPT_HELPER_URL=http://receipt-helper:8070/parse
# RECEIPT_HELPER_MODE=http
# RECEIPT_HELPER_TIMEOUT_MS=60000
# RECEIPT_HELPER_TOKEN=
