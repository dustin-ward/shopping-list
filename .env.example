# Copy to .env for local development. In production, set the canonical HTTPS
# origin to the Tailscale Serve hostname used by clients.
DATABASE_PATH=/data/shopping-list.sqlite
CANONICAL_ORIGIN=https://shopping-list.example.ts.net
PORT=3000
LOG_LEVEL=info

# Host loopback port published for Tailscale Serve on the host.
PUBLISHED_PORT=3000
BACKUP_DIR=/backups

# Optional published image for a GHCR deployment. Leave unset to build locally.
# SHOPPING_LIST_IMAGE=ghcr.io/owner/repository:latest

# Receipt scanning (optional; RECEIPT_OCR_URL unset = capture disabled).
# To enable it, start the sidecar too: docker compose --profile ocr up -d
# RECEIPT_CURRENCY=USD
# RECEIPT_OCR_URL=http://receipt-ocr:8060/ocr  # the feature flag: enables capture + the worker
# RECEIPT_OCR_MODE=http                        # 'stub' (dev/tests) replays a committed fixture instead
# RECEIPT_OCR_STUB_FIXTURE=                    # dev/tests only: replay a different OCR payload
# RECEIPT_OCR_TIMEOUT_MS=30000
# RECEIPT_OCR_TOKEN=                           # set the same value for receipt-ocr to require a bearer token
# RECEIPT_OCR_IMAGE=shopping-list-receipt-ocr:local  # sidecar image; unset builds it locally
# INDRA_OCR_THREADS=4                          # sidecar inference threads
# RECEIPT_STORAGE_DIR=/data/receipts
# RECEIPT_IMAGE_RETENTION=keep
# Optional fallback re-parse helper (R4). Unset = no offer in review; the tier
# is a seam with no engine shipped yet (docs/adr/0004-fallback-reparse-tier.md).
# RECEIPT_HELPER_URL=http://receipt-helper:8070/parse
# RECEIPT_HELPER_MODE=http                        # 'stub' (dev/tests) replays a committed fixture
# RECEIPT_HELPER_TIMEOUT_MS=60000
# RECEIPT_HELPER_TOKEN=
# adapter-node body cap; required for receipt uploads (12 MB, route caps at 10 MB).
# BODY_SIZE_LIMIT=12M
